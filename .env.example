# Copy to .env and fill in. Path B (API access) only -- the `local`, `inspect` and
# `fill` commands need none of this.
#
# These come from a Server-to-Server OAuth app on the CCCD Zoom tenant, which an
# admin has to create. See README.md for exactly what to ask district IT for.
#
# .env holds a client secret. Treat it like a password: don't commit it, don't put
# it on a shared drive, don't paste it into chat.

ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Whose recordings to read. "me" is the account that owns the OAuth app.
# If ASG meetings are hosted by an advisor or a Student Life account, put that
# host's Zoom user id or email here instead (needs admin-level recording scopes).
ZOOM_USER_ID=me

# Optional. Digits only. Filters `list` and `fetch` to the ASG meeting so other
# recordings on the account don't show up. It is in the meeting's Zoom invite link.
ASG_MEETING_ID=12345678901

# ---------------------------------------------------------------------------
# Live Minutes app (run_app.py)
# ---------------------------------------------------------------------------
# AI provider keys. Set only the one(s) you use. Local models need none.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
XAI_API_KEY=
HF_TOKEN=
# Any OpenAI-compatible server (vLLM, a campus-hosted model, etc.)
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=

# Optional Zoom General app, authorized by the account that hosts the meetings.
# See docs/ZOOM-APP-SETUP.md. The Secret Token verifies Zoom's signed events.
ZOOM_APP_CLIENT_ID=
ZOOM_APP_CLIENT_SECRET=
ZOOM_APP_SECRET_TOKEN=
# ZOOM_APP_REDIRECT_URI=http://localhost:8765/zoom/callback

# Live mode: redraft after this many new lines or seconds
# MINUTES_LIVE_LINES=25
# MINUTES_LIVE_SECONDS=90

OFFSITE_S3_ENDPOINT=
OFFSITE_S3_BUCKET=
OFFSITE_S3_ACCESS_KEY_ID=
OFFSITE_S3_SECRET_ACCESS_KEY=
OFFSITE_BACKUP_PUBLIC_KEY=
OFFSITE_KEEP_DAYS=30
FREE_AI_URL=
FREE_AI_MODELS=
FREE_AI_CONTEXT=32768
LIBRETRANSLATE_URL=

# Copy to .env next to docker-compose.yml and fill in. Never commit the real file.

# 64 random characters. Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Signs sessions and links. Changing it signs everyone out.
SECRET_KEY=

# Encrypts stored AI keys and Zoom tokens. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# To rotate: put the new key first, keep the old one after it, run  python -m server.manage rotate-keys
ENCRYPTION_KEYS=

# Database password used by docker-compose
POSTGRES_PASSWORD=

# The address people will use. Must be https in production; cookies become Secure automatically.
PUBLIC_URL=https://minutes.yourdistrict.edu
# Extra host names this server answers to (comma separated). The PUBLIC_URL host is always allowed.
ALLOWED_HOSTS=
# How many proxies sit in front of the app and add X-Forwarded-For (Azure Container Apps or Render: 1)
TRUSTED_PROXY_HOPS=1

# Who can administer the whole server. Granted only after the address is verified by email link or SSO.
# Or run:  python -m server.manage make-admin it-admin@yourdistrict.edu
PLATFORM_ADMIN_EMAILS=it-admin@yourdistrict.edu

# 0 = accounts only by invite or allowed school email domains
ALLOW_SIGNUP=0
# 0 = only platform administrators can create a new district
ALLOW_DISTRICT_CREATION=0

# 1 only when the server is inside the district network and should reach a campus-hosted model
ALLOW_PRIVATE_LLM_URLS=0

# Email for invites, address confirmation, and password resets (smtp or none)
MAIL_BACKEND=smtp
MAIL_FROM=Live Minutes <minutes@yourdistrict.edu>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=1

# Optional: Google / Microsoft school sign-in
# Redirect URI to register:  {PUBLIC_URL}/api/auth/sso/google/callback  and  .../microsoft/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Limit Google sign-in to your Workspace domains (comma separated), for example yourdistrict.edu
GOOGLE_ALLOWED_DOMAINS=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=organizations
# Required for Microsoft sign-in: your Entra directory (tenant) IDs, comma separated
MICROSOFT_ALLOWED_TENANTS=

# Optional: Zoom General app. Redirect URI: {PUBLIC_URL}/api/zoom/callback, events: {PUBLIC_URL}/api/zoom/events
ZOOM_APP_CLIENT_ID=
ZOOM_APP_CLIENT_SECRET=
ZOOM_APP_SECRET_TOKEN=

# Optional: store files in S3-compatible storage instead of the local volume
S3_BUCKET=
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Account rules. Breach check sends only the first 5 characters of a SHA-1 hash to Have I Been Pwned.
EMAIL_DNS_CHECK=1
PASSWORD_BREACH_CHECK=1
# Optional Cloudflare Turnstile on sign-up, sign-in, and password reset (free, from the Cloudflare dashboard)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Folder holding the Cloudflare Tunnel config.yml and credentials (docker compose --profile tunnel)
TUNNEL_DIR=

# Sessions end after this many idle hours, and always after SESSION_DAYS
SESSION_IDLE_HOURS=12
SESSION_DAYS=14

# Live drafting cadence
LIVE_LINES=25
LIVE_SECONDS=90

# Extra S3-compatible backup hosts allowed for district IT, comma separated (for example minio.district.edu)
BACKUP_S3_HOSTS=
